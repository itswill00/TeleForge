# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Command trigger prefix for userbot (default: .)
TRIGGER=.

# Optional: Command trigger prefix for companion bot (default: /)
# BOT_TRIGGER=/

# Optional: Pyrogram String Session generated via `python generate_session.py`
# If set, TeleForge uses memory session without generating a local .session file
# SESSION_STRING=

# Optional: Companion Bot Token from @BotFather
# BOT_TOKEN=


# Optional: Your Telegram numeric User ID (auto-discovered on launch)
# OWNER_ID=

# Optional: Private group or channel ID for security, restart, and battery thermal alerts
# e.g., LOG_CHAT=-1001234567890 (or configure on the fly via `.setlog` in your private group)
# LOG_CHAT=

# Optional: Process Runner Mode (auto, true, false)
# auto = use tmux if available, otherwise background daemon
# false = force background daemon (nohup with PID tracking)
# true = force tmux session
# USE_TMUX=auto

# Optional: Android Termux wake-lock acquisition (true/false)
# USE_WAKELOCK=true

# Optional: Logging level (INFO, DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: Log file rotation size threshold in megabytes
# LOG_MAX_MB=10

# Optional: Battery thermal watchdog toggle and alert threshold in Celsius
# WATCHDOG_ENABLED=true
# BATTERY_THRESHOLD=42.0
